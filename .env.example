# PayPal sandbox app (developer.paypal.com > Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
# JSON list of {"email": "...", "payer_id": "..."} sandbox buyers
PAYPAL_SANDBOX_BUYERS=[]
# Postgres (Neon or any Postgres 16)
DATABASE_URL=
TEST_DATABASE_URL=
# Any OpenAI-compatible endpoint. Verified: Sarvam https://api.sarvam.ai/v1 with LLM_MODEL=sarvam-105b.
# Also works: Gemini (.../v1beta/openai/), Groq, Nebius Token Factory.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=
LLM_FAST_MODEL=
# Output budget per call; reasoning models (sarvam-105b) need well above 2048
LLM_MAX_TOKENS=8192
# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# base64 Ed25519 seed: uv run python scripts/make_keys.py
MERCHANT_SIGNING_KEY=
# agent_id:key pairs, comma separated
MCP_AGENT_KEYS=
ADMIN_PASSWORD=
SESSION_SECRET=
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
SIMULATOR_ENABLED=false
ALLOW_SIMULATED_WEBHOOKS=false
DEMO_ENABLED=false
DEMO_DISPUTE_POOL=
# Optional shopping demo (backend only; also requires DEMO_ENABLED=true and PayPal sandbox)
CHANNEL3_API_KEY=
KERNEL_API_KEY=
